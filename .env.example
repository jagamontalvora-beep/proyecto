# MongoDB Atlas: configura usuario, contraseña codificada y host de tu cluster.
MONGODB_URI=
PORT=4000
HOST=127.0.0.1
# Orígenes permitidos separados por coma; Sandbox habilitado en desarrollo.
CORS_ORIGINS=http://localhost:4000,http://127.0.0.1:4000,https://studio.apollographql.com
NODE_ENV=development
